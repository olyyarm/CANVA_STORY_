# По умолчанию приложение работает на локальных тестовых данных.
VITE_MOCK_MODE=true

# Только для локального запуска. Любая VITE_* переменная попадает в клиентский bundle
# и не должна использоваться как настоящий секрет в публичной GitHub Pages-сборке.
VITE_MISTRAL_API_KEY=

# LM Studio переключается прямо в интерфейсе. По умолчанию приложение предлагает
# http://localhost:1234/v1/chat/completions; для домашней сети можно указать
# http://192.168.1.10:1234 или полный /v1/chat/completions endpoint в верхней панели.

# ComfyUI для генерации кадров тоже настраивается в интерфейсе.
# Дефолт: http://localhost:8188, pipeline SDXL, checkpoint SDXL\sd_xl_base_1.0.safetensors.
